{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dataset-record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task": {
      "enum": [
        "fiction",
        "editing",
        "analysis",
        "dialogue",
        "pacing",
        "storytelling"
      ]
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "split_group": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "origin": {
      "enum": [
        "human",
        "synthetic",
        "derived"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "source_work_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "rights_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rights_record_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "rights_record_id",
          "start",
          "end",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "teacher": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "terms_url": {
              "type": "string",
              "format": "uri"
            },
            "training_permission": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "review": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "pending",
                    "approved",
                    "rejected",
                    "needs-specialist-review"
                  ]
                },
                "reviewer": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reviewed_on": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reviewer",
                "reviewed_on",
                "notes"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "approved"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "reviewer": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "reviewed_on": {
                        "type": "string",
                        "format": "date"
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "model",
            "revision",
            "terms_url",
            "training_permission",
            "review"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "needs-specialist-review"
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_on",
        "notes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reviewed_on": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      ]
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "dataset_version",
    "task",
    "split",
    "split_group",
    "origin",
    "messages",
    "source_work_ids",
    "rights_record_ids",
    "source_spans",
    "teacher",
    "review",
    "rubric",
    "content_hash"
  ],
  "additionalProperties": false
}
