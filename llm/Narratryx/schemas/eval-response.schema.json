{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eval-response",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "text": {
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "completion_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "text",
    "error",
    "latency_ms",
    "completion_tokens"
  ],
  "additionalProperties": false
}
