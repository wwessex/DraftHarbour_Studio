{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eval-task",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "task": {
      "enum": [
        "fiction",
        "editing",
        "analysis",
        "dialogue",
        "pacing",
        "storytelling"
      ]
    },
    "split_group": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "word_count"
              },
              "min": {
                "type": "integer",
                "minimum": 0
              },
              "max": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "type",
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "exact",
                  "contains",
                  "excludes"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "json"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "quotes_from_context"
              },
              "min_quotes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "type",
              "min_quotes"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "line_count"
              },
              "min": {
                "type": "integer",
                "minimum": 1
              },
              "max": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "type",
              "min",
              "max"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "needs-specialist-review"
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_on",
        "notes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reviewed_on": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "const": "original_synthetic"
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "source_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "origin",
        "created_by",
        "source_note"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "scenario_id",
    "task",
    "split_group",
    "context",
    "prompt",
    "rubric",
    "checks",
    "review",
    "provenance"
  ],
  "additionalProperties": false
}
