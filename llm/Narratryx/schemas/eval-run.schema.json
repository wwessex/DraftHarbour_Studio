{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eval-run",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tokenizer_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "runtime": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "generation": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        }
      },
      "required": [
        "temperature",
        "max_tokens",
        "seed"
      ],
      "additionalProperties": false
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "benchmark_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "model",
    "model_revision",
    "tokenizer_revision",
    "prompt_version",
    "runtime",
    "generation",
    "artifact_sha256",
    "benchmark_sha256"
  ],
  "additionalProperties": false
}
