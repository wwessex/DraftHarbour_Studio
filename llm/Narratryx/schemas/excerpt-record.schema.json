{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "excerpt-record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rights_record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_work_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 61
    },
    "focus": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "span": {
      "type": "object",
      "properties": {
        "rights_record_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "rights_record_id",
        "start",
        "end",
        "text"
      ],
      "additionalProperties": false
    },
    "source_lines": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_span_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transformation": {
      "type": "object",
      "properties": {
        "id": {
          "const": "join-soft-wraps-v1"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "joined_line_breaks": {
          "type": "integer",
          "minimum": 0
        },
        "preserves_paragraphs": {
          "const": true
        },
        "preserves_emphasis_markup": {
          "const": true
        },
        "removed_content": {
          "const": false
        }
      },
      "required": [
        "id",
        "description",
        "joined_line_breaks",
        "preserves_paragraphs",
        "preserves_emphasis_markup",
        "removed_content"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "needs-specialist-review"
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_on",
        "notes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reviewed_on": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "rights_record_id",
    "source_work_id",
    "source_sha256",
    "source_path",
    "chapter",
    "focus",
    "span",
    "source_lines",
    "text",
    "text_sha256",
    "raw_span_sha256",
    "transformation",
    "review"
  ],
  "additionalProperties": false
}
