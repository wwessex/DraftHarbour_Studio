{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "paid_execution_enabled": {
      "const": false
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "ledger": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "string",
      "minLength": 1
    },
    "lock": {
      "type": "string",
      "minLength": 1
    },
    "rubric": {
      "type": "string",
      "minLength": 1
    },
    "prepare_austen": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "spec": {
              "type": "string",
              "minLength": 1
            },
            "source_manifest": {
              "type": "string",
              "minLength": 1
            },
            "approval": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "spec",
            "source_manifest",
            "approval"
          ],
          "additionalProperties": false
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "license_url": {
              "type": "string",
              "format": "uri"
            },
            "license_review": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "pending",
                    "approved",
                    "rejected",
                    "needs-specialist-review"
                  ]
                },
                "reviewer": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reviewed_on": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reviewer",
                "reviewed_on",
                "notes"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "approved"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "reviewer": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "reviewed_on": {
                        "type": "string",
                        "format": "date"
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "id",
            "revision",
            "license_url",
            "license_review"
          ],
          "additionalProperties": false
        }
      ]
    },
    "training": {
      "type": "object",
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_length": {
          "type": "integer",
          "minimum": 128,
          "maximum": 4096
        },
        "save_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "max_steps",
        "max_length",
        "save_steps",
        "seed"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "responses": {
              "type": "string",
              "minLength": 1
            },
            "run": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "responses",
            "run"
          ],
          "additionalProperties": false
        }
      ]
    },
    "candidate": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "responses": {
              "type": "string",
              "minLength": 1
            },
            "run": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "responses",
            "run"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "paid_execution_enabled",
    "jurisdictions",
    "ledger",
    "dataset",
    "tasks",
    "lock",
    "rubric",
    "prepare_austen",
    "model",
    "training",
    "baseline",
    "candidate"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
